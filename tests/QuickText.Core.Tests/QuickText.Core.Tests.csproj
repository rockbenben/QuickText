<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test assemblies are self-executing, so the project must build an exe. -->
    <OutputType>Exe</OutputType>
    <!--
      Run on Microsoft.Testing.Platform instead of the VSTest bridge. That is what makes the
      platform's own `minimum-expected-tests` option available (see how ci.yml passes it), which is
      the whole reason CI no longer parses a .trx by hand to catch a silent 0-test run.

      With MTP driving the run, Microsoft.NET.Test.Sdk / xunit.runner.visualstudio / coverlet.collector
      are all VSTest-side pieces with nothing left to do — dropping them also cleared the MTP0001
      "VSTest-specific properties are set but will be ignored" warning they caused on every build.
      Trade-off: IDE test discovery now needs MTP support enabled (VS 17.14+, recent Rider). Put
      Microsoft.NET.Test.Sdk + xunit.runner.visualstudio back if you run tests from Test Explorer.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QuickText.Core\QuickText.Core.csproj" />
  </ItemGroup>

</Project>