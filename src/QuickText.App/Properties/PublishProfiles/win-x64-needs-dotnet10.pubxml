<Project>
  <!-- Same single-file exe as win-x64, minus the bundled .NET runtime: a fraction of the size, but
       it only starts on a machine with the .NET 10 Desktop Runtime installed. The profile (and the
       release asset it produces) is named for what it costs the reader — "needs dotnet10" is a thing
       you can act on, where "no-runtime" only describes what is missing. The version in the name is
       load-bearing: moving to .NET 11 must change it, or people on 10 download an exe that won't
       start. Compression is deliberately absent - EnableCompressionInSingleFile is
       self-contained-only and errors here. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- don't copy referenced projects' .pdb next to the single exe -->
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\Release\publish-needs-dotnet10\</PublishDir>
  </PropertyGroup>
</Project>
