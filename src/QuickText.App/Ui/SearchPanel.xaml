<Window x:Class="QuickText.App.Ui.SearchPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:QuickText.App"
        xmlns:pt="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="{Binding [App.Name], Source={x:Static app:LocProxy.Instance}}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="False"
        Width="680" SizeToContent="Height" MinWidth="480" MinHeight="340" ResizeMode="NoResize"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <ContextMenu x:Key="RowMenu" Style="{StaticResource DarkContextMenu}">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}"/>
                <Style TargetType="Separator" BasedOn="{StaticResource DarkMenuSeparator}"/>
            </ContextMenu.Resources>
            <MenuItem Header="{Binding [Ctx.Copy], Source={x:Static app:LocProxy.Instance}}" Click="OnCtxCopy">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"/></MenuItem.Icon>
            </MenuItem>
            <!-- Its own string, not the rail's "Favorites" label: this item is a command that
                 toggles, and its siblings are verbs. One string, one job. -->
            <MenuItem Header="{Binding [Ctx.Favorite], Source={x:Static app:LocProxy.Instance}}" Click="OnCtxFavorite">
                <MenuItem.Icon><TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.Star}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{Binding [Ctx.Edit], Source={x:Static app:LocProxy.Instance}}" Click="OnCtxEdit">
                <MenuItem.Icon><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <Border Margin="18" CornerRadius="16" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="9" Direction="270" Opacity="0.5" Color="#FF000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- Star, not Auto, even in auto-height mode: with SizeToContent=Height a star row
                     still measures to its content, but when the window's MinHeight exceeds what the
                     content needs, the slack lands HERE instead of pooling below the footer. With
                     Auto every row was content-sized, the Grid was top-aligned inside a 340-tall
                     window, and two results left a dead strip under the hint bar.
                     The preview pane lives INSIDE this row (see below): it overlays the list's
                     bottom instead of taking a row of its own, so it can never squeeze the list. -->
                <RowDefinition x:Name="BodyRow" Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- input -->
            <Grid Grid.Row="0" Margin="20,18,20,13" Background="Transparent" MouseLeftButtonDown="OnInputDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                           Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,13,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Style="{StaticResource GhostIconButton}" FontSize="14"
                            Content="&#xE710;" Click="OnNewSnippet"
                            ToolTip="{Binding [Search.Hint.New], Source={x:Static app:LocProxy.Instance}}"/>
                    <Button Style="{StaticResource GhostIconButton}" FontSize="14" Margin="4,0,0,0"
                            Content="&#xE8F1;" Click="OnOpenManager"
                            ToolTip="{Binding [Tray.OpenManager], Source={x:Static app:LocProxy.Instance}}"/>
                    <Button Style="{StaticResource GhostIconButton}" FontSize="14" Margin="4,0,0,0"
                            Content="&#xE713;" Click="OnOpenSettings"
                            ToolTip="{Binding [Tray.Settings], Source={x:Static app:LocProxy.Instance}}"/>
                    <Button x:Name="PinButton" Style="{StaticResource GhostIconButton}" FontSize="14"
                            Content="&#xE718;" Margin="4,0,0,0" Click="OnTogglePin"
                            ToolTip="{Binding [Search.KeepOpen], Source={x:Static app:LocProxy.Instance}}"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <TextBox x:Name="Query" Background="Transparent" BorderThickness="0" Padding="0"
                             FontFamily="{StaticResource Font.Ui}" FontSize="19"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             CaretBrush="{DynamicResource Brush.Accent}"
                             SelectionBrush="{DynamicResource Brush.Accent}"
                             VerticalContentAlignment="Center" TextChanged="OnQueryChanged"/>
                    <TextBlock Text="{Binding [Search.Placeholder], Source={x:Static app:LocProxy.Instance}}"
                               FontFamily="{StaticResource Font.Ui}" FontSize="19"
                               Foreground="{DynamicResource Brush.TextFaint}" IsHitTestVisible="False"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Query}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Divider}" Margin="16,0"/>

            <!-- body: browse (two-pane) / search results / empty -->
            <Grid Grid.Row="2" Margin="8,7,8,7">
                <!-- browse mode: category rail | snippets -->
                <Grid x:Name="BrowseView">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="182"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="CategoryRail" Grid.Column="0" Background="Transparent" BorderThickness="0"
                             MaxHeight="404" HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="False" ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemTemplate="{StaticResource CategoryRowTemplate}"
                             ItemContainerStyle="{StaticResource CategoryRailItem}"
                             SelectionChanged="OnCategoryChanged"/>
                    <Border Grid.Column="1" Background="{DynamicResource Brush.Divider}" Margin="0,3"/>
                    <ListBox x:Name="BrowseList" Grid.Column="2" Background="Transparent" BorderThickness="0" Margin="7,0,0,0"
                             MaxHeight="404" HorizontalContentAlignment="Stretch" AlternationCount="99"
                             VirtualizingPanel.IsVirtualizing="False" ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemTemplate="{StaticResource SnippetRowTemplate}"
                             ItemContainerStyle="{StaticResource SnippetRowContainer}"
                             ContextMenu="{StaticResource RowMenu}"
                             PreviewMouseRightButtonDown="OnRowRightClick"
                             SelectionChanged="OnSnippetSelectionChanged"
                             MouseLeftButtonUp="OnListClick"
                             MouseDoubleClick="OnResultsDoubleClick"/>
                </Grid>

                <!-- search mode: flat ranked results -->
                <ListBox x:Name="Results" Visibility="Collapsed" Background="Transparent" BorderThickness="0" MaxHeight="404"
                         HorizontalContentAlignment="Stretch" AlternationCount="99"
                         VirtualizingPanel.IsVirtualizing="False" ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemTemplate="{StaticResource SnippetRowTemplate}"
                         ItemContainerStyle="{StaticResource SnippetRowContainer}"
                         ContextMenu="{StaticResource RowMenu}"
                         PreviewMouseRightButtonDown="OnRowRightClick"
                         SelectionChanged="OnSnippetSelectionChanged"
                         MouseLeftButtonUp="OnListClick"
                         MouseDoubleClick="OnResultsDoubleClick"/>

                <!-- empty state -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" MinHeight="118"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,16">
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Ui}" FontSize="13"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock x:Name="EmptySub" HorizontalAlignment="Center" Margin="0,5,0,0"
                               FontFamily="{StaticResource Font.Ui}" FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextFaint}"/>
                    <Button x:Name="CreateButton" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,14,0,0"
                            Style="{StaticResource DarkButtonPrimary}" Padding="16,6" FontSize="12.5"
                            Click="OnCreateFromQuery"/>
                </StackPanel>

                <!-- Full-text preview of the selected snippet, OVERLAID on the list's bottom.
                     Two states: COLLAPSED (default) is a one-line strip — the body's first line
                     plus a chevron — costing the list a third of a row; EXPANDED grows the pane
                     over the list's bottom (rows stay reachable: CapPreview pads the lists, and
                     selecting another snippet folds the pane back to the strip). Opaque Surface
                     background — rows scrolling under a translucent pane would ghost through. -->
                <Border x:Name="PreviewPane" Visibility="Collapsed" Panel.ZIndex="1"
                        VerticalAlignment="Bottom" Margin="12,0,12,10"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8" Padding="0,10,0,0">
                    <StackPanel>
                        <Border x:Name="PreviewHeader" Cursor="Hand" Padding="2,7,2,7"
                                MouseLeftButtonUp="OnPreviewToggle">
                            <!-- hover affordance lives in a Style, not an attribute: an inline
                                 Background would outrank the IsMouseOver trigger and eat it. -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.RowHover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PreviewEye" Grid.Column="0" Margin="2,0,8,0"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource Brush.TextMuted}" Text="&#xE7B3;"/>
                                <TextBlock x:Name="PreviewSummary" Grid.Column="1"
                                           TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Font.Ui}"
                                           FontSize="12.5" Foreground="{DynamicResource Brush.TextFaint}"/>
                                <TextBlock x:Name="PreviewChevron" Grid.Column="2" Margin="10,0,2,0"
                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}" Text="&#xE70E;"/>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="PreviewScroll" MaxHeight="150" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontFamily="{StaticResource Font.Ui}"
                                           FontSize="13" LineHeight="19" Foreground="{DynamicResource Brush.TextMuted}"/>
                                <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="138" HorizontalAlignment="Left" Visibility="Collapsed"/>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- footer -->
            <Border Grid.Row="3" Background="{DynamicResource Brush.FooterBg}" CornerRadius="0,0,16,16" Padding="18,10">
                <!-- Two COLUMNS, not two overlapping layers in one cell: the legend and the result
                     count used to be stacked on top of each other, so at the panel's own MinWidth a
                     long translation (Russian) ran straight under the count and both became
                     illegible. The count now reserves its width, and the legend — progressive
                     disclosure, least important on the right — clips instead of colliding. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- The legend follows the state: with no rows there is nothing to select, and
                         Enter creates instead of sends (see OnPreviewKeyDown). Two prebuilt Enter
                         groups rather than retargeting one label, so the localized bindings stay
                         live through a language switch. -->
                    <!-- WrapPanel, not a clipped StackPanel: clipping cut at whatever pixel the edge
                         fell on, which sliced a word in half — German showed "esc Scl", French left a
                         one-pixel stub of "Fermer" that reads as a rendering artifact. Wrapping keeps
                         every hint legible and costs one extra footer line only at the narrowest
                         widths, where the alternative was losing the hint anyway. -->
                    <!-- The 4px bottom on each group is the gutter BETWEEN wrapped lines; the -4 here cancels
                         it again when nothing wraps, so the common single-line footer keeps its old height. -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,-4">
                        <StackPanel x:Name="HintNav" Orientation="Horizontal" Margin="0,0,16,4">
                            <Border Style="{StaticResource HintKey}"><TextBlock Text="↑↓" Style="{StaticResource HintKeyText}"/></Border>
                            <TextBlock Text="{Binding [Search.Hint.Nav], Source={x:Static app:LocProxy.Instance}}" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                        <StackPanel x:Name="HintCat" Orientation="Horizontal" Margin="0,0,16,4">
                            <Border Style="{StaticResource HintKey}"><TextBlock Text="←→" Style="{StaticResource HintKeyText}"/></Border>
                            <TextBlock Text="{Binding [Search.Hint.SwitchCat], Source={x:Static app:LocProxy.Instance}}" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                        <StackPanel x:Name="HintSend" Orientation="Horizontal" Margin="0,0,16,4">
                            <Border Style="{StaticResource HintKey}"><TextBlock Text="↵" Style="{StaticResource HintKeyText}"/></Border>
                            <TextBlock Text="{Binding [Search.Hint.Send], Source={x:Static app:LocProxy.Instance}}" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                        <!-- Search.Hint.Create, NOT Search.Hint.New: this Enter runs the same action
                             as the empty-state button (Search.CreateNew, "创建「x」"), and an action
                             keeps one name everywhere. "新建" belongs to the + button, which makes a
                             blank snippet instead. -->
                        <StackPanel x:Name="HintCreate" Orientation="Horizontal" Margin="0,0,16,4" Visibility="Collapsed">
                            <Border Style="{StaticResource HintKey}"><TextBlock Text="↵" Style="{StaticResource HintKeyText}"/></Border>
                            <TextBlock Text="{Binding [Search.Hint.Create], Source={x:Static app:LocProxy.Instance}}" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource HintKey}"><TextBlock Text="esc" Style="{StaticResource HintKeyText}"/></Border>
                            <TextBlock Text="{Binding [Search.Hint.Close], Source={x:Static app:LocProxy.Instance}}" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Grid.Column="1" x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontFamily="{StaticResource Font.Ui}" FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextFaint}"/>
                </Grid>
            </Border>

            <!-- resize grip -->
            <pt:Thumb Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="18" Height="18"
                      Margin="0,0,3,3" Cursor="SizeNWSE" DragDelta="OnResizeDrag">
                <pt:Thumb.Template>
                    <ControlTemplate TargetType="pt:Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 16,5 L 16,16 L 5,16 Z" Fill="{DynamicResource Brush.TextFaint}" Opacity="0.6"/>
                        </Grid>
                    </ControlTemplate>
                </pt:Thumb.Template>
            </pt:Thumb>
        </Grid>
    </Border>
</Window>
