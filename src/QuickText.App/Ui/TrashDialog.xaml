<Window x:Class="QuickText.App.Ui.TrashDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="440" ResizeMode="CanResize" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.WinBg}" FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextPrimary}"/>
        <TextBlock Grid.Row="1" x:Name="HintText" FontSize="11.5" Margin="0,4,0,10"
                   Foreground="{DynamicResource Brush.TextFaint}" TextWrapping="Wrap"/>

        <ListBox Grid.Row="2" x:Name="Items" SelectionMode="Extended"
                 Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource DarkListItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3" ToolTip="{Binding Tip}">
                        <!-- Name and Preview are the user's own text: render each in ITS OWN
                             direction so an RTL layout can't re-order it (Core.BidiText). Detail is
                             our text and keeps inheriting the UI's direction. -->
                        <TextBlock Text="{Binding Name}"
                                   FlowDirection="{Binding Name, Converter={StaticResource ContentFlow}}"
                                   FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBlock Text="{Binding Preview}"
                                   FlowDirection="{Binding Preview, Converter={StaticResource ContentFlow}}"
                                   FontSize="11" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Brush.TextFaint}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="13" Foreground="{DynamicResource Brush.TextFaint}" Visibility="Collapsed"/>

        <!-- Was a DockPanel: the three left buttons docked first and Close docked last, so Close only
             got the width they left over — in Russian and German that was a few pixels, i.e. the way
             out of the dialog was clipped to a sliver. Close now reserves its column first, and the
             actions wrap to a second line instead of pushing it off. -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Gaps ride on each button's RIGHT edge, and the -6 here cancels the per-button 6 when
                 nothing wraps. A left inset survives a wrap: put the separator on Delete's left and
                 the moment the row breaks, Delete lands first on line two still carrying it, indented
                 20px under Restore — ragged in exactly the locales the wrapping exists for. -->
            <WrapPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,-6">
                <!-- Both are irreversible and both sat in the same grey as Close, one button away from
                     the primary Restore. Danger styling + a wider gap after Restore separate "puts it
                     back" from "gone for good". -->
                <Button x:Name="RestoreButton" Style="{StaticResource DarkButtonPrimary}"
                        Padding="14,7" Margin="0,0,20,6" Click="OnRestore"/>
                <Button x:Name="DeleteButton" Style="{StaticResource DarkButtonDanger}"
                        Padding="14,7" Margin="0,0,8,6" Click="OnDeleteForever"/>
                <Button x:Name="EmptyButton" Style="{StaticResource DarkButtonDanger}"
                        Padding="14,7" Margin="0,0,0,6" Click="OnEmptyTrash"/>
            </WrapPanel>
            <Button Grid.Column="1" x:Name="CloseButton" Style="{StaticResource DarkButton}"
                    VerticalAlignment="Top" Padding="14,7" Margin="12,0,0,0" Click="OnClose"/>
        </Grid>
    </Grid>
</Window>
